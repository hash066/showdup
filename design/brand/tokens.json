{
  "color": {
    "ink": {
      "$type": "color",
      "$value": "#0E0E0C",
      "$description": "Background"
    },
    "carbon": {
      "$type": "color",
      "$value": "#171714",
      "$description": "Sheets and rare surfaces"
    },
    "graphite": {
      "$type": "color",
      "$value": "#262622",
      "$description": "Hairlines and inactive tracks"
    },
    "graphite-strong": {
      "$type": "color",
      "$value": "#3A3A34",
      "$description": "Borders on controls, companion penguin"
    },
    "paper": {
      "$type": "color",
      "$value": "#F2EEE6",
      "$description": "Primary text, 16:1 on ink"
    },
    "stone": {
      "$type": "color",
      "$value": "#8F8A80",
      "$description": "Secondary text, 5.6:1 on ink; not on graphite"
    },
    "mint": {
      "$type": "color",
      "$value": "#5CF0BE",
      "$description": "You, primary action, released; text on mint uses ink"
    },
    "mint-deep": {
      "$type": "color",
      "$value": "#2A9C77",
      "$description": "Companion ears and details"
    },
    "alert": {
      "$type": "color",
      "$value": "#FF6B5E",
      "$description": "Destructive actions only, never for misses"
    }
