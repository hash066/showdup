rules_version = '2';

// FROZEN CONTRACT. Every negative case in section 9.2 of the plan must
// be denied by these rules. Cloud Functions use the Admin SDK and bypass
// them, which is exactly why every write path lives in a function.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /socialUsers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /battleMemberships/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /battles/{battleId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow write: if false;

      match /scores/{uid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/battles/$(battleId)).data.memberUids;
        allow write: if false;
      }

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    match /battleInvites/{code} {
      allow read, write: if false;
    }

    match /rateLimits/{bucket} {
      allow read, write: if false;
    }
  }
}
