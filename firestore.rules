rules_version = '2';

// FROZEN CONTRACT. Every negative case in section 9.2 of the plan must
// be denied by these rules. Cloud Functions use the Admin SDK and bypass
// them, which is exactly why every write path lives in a function.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // A new user doc may not arrive carrying entitlement or stats.
      allow create: if isOwner(uid)
        && request.resource.data.keys()
             .hasOnly(['displayName', 'handle', 'photoUrl', 'timezone', 'oneSignalId', 'createdAt', 'updatedAt']);

      // Only profile fields are client writable. isPro, proExpiresAt and
      // stats are function territory.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'handle', 'photoUrl',
                       'timezone', 'oneSignalId', 'updatedAt']);

      allow delete: if false;
    }

    match /commitments/{commitmentId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      // createCommitment / updateCommitment only.
      allow write: if false;
    }

    match /attempts/{attemptId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      // No client writes, ever. This is what makes completedAt trustworthy.
      allow write: if false;

      // Reminder events are function-written only (recordReminderEvent).
      match /events/{eventId} {
        allow read, write: if false;
      }
    }
  }
}
